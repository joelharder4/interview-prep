{
  "name": "interview-prep-monorepo",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "npm run dev:wsl",
    "dev:wsl": "wsl bash scripts/dev.sh",
    "dev:bash": "bash scripts/dev.sh",
    "dev:check": "bash scripts/dev.sh --check",
    "dev:check:wsl": "wsl bash scripts/dev.sh --check",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "build": "cd frontend && npm run build",
    "preview": "cd frontend && npm run preview",
    "lint": "cd frontend && npm run lint"
  },
  "description": "Interview prep tool with local code execution backend"
}
